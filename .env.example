# Set strong unique values before any public deployment.
SECRET_KEY=replace-with-a-long-random-secret
APP_PASSWORD=choose-a-long-site-password
# Keep this allowlist limited to sources you are legally permitted to process.
ALLOWED_DOMAINS=youtube.com,youtu.be
# Container uses /app/downloads; local runs use ./downloads by default.
DOWNLOAD_DIR=./downloads
MAX_ACTIVE_JOBS=2
MAX_DURATION_SECONDS=7200
MAX_FILE_MB=1024
